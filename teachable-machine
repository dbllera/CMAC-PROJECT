<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Coffee, Bottle or Face</title>
<style>
  body { font-family: -apple-system, system-ui, sans-serif; max-width: 520px; margin: 24px auto; padding: 0 16px; background: #fafafa; color: #222; }
  h1 { font-size: 20px; }
  details { border: 1px solid #ddd; border-radius: 8px; margin: 12px 0; padding: 6px 10px; font-size: 14px; }
  input[type=text] { width: 100%; box-sizing: border-box; padding: 6px; }
  button { font-size: 16px; padding: 8px 20px; border: 0; border-radius: 6px; background: #1a73e8; color: #fff; cursor: pointer; }
  button:disabled { background: #999; cursor: default; }
  #status { margin: 10px 0; font-size: 14px; }
  #status.error { color: #c5221f; }
  #webcam-container canvas { width: 100%; max-width: 300px; border-radius: 8px; border: 6px solid #ddd; transition: border-color .2s; }
  .row { margin: 8px 0; }
  .name { display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 3px; }
  .track { height: 18px; background: #e6e6e6; border-radius: 9px; overflow: hidden; }
  .bar { height: 100%; width: 0; border-radius: 9px; transition: width .1s; }
  #top { font-size: 26px; font-weight: 600; padding: 12px; border-radius: 8px; color: #fff; text-align: center; margin: 10px 0; display: none; }
</style>
</head>
<body>
<h1>☕ Coffee · 💧 Water Bottle · 🙂 Face</h1>

<button type="button" id="start-btn" onclick="init()">Start</button>
<div id="status"></div>
<div id="top"></div>
<div id="webcam-container"></div>
<div id="label-container"></div>

<details id="model-picker">
  <summary>Model source (only needed if it doesn't load automatically)</summary>
  <p>By default this loads <code>./my_model/</code> next to this file. If you opened this page by
     double-clicking it, the browser blocks that, so pick the 3 files from the
     <code>my_model</code> folder here instead:</p>
  <input type="file" id="model-files" multiple accept=".json,.bin">
  <p>…or paste a shareable Teachable Machine link:</p>
  <input type="text" id="model-url" placeholder="https://teachablemachine.withgoogle.com/models/XXXXX/">
</details>

<!-- Pinned versions: tfjs@latest is incompatible with the Teachable Machine library -->
<script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@1.3.1/dist/tf.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@teachablemachine/image@0.8.5/dist/teachablemachine-image.min.js"></script>
<script type="text/javascript">
    // Folder containing model.json, metadata.json and weights.bin
    const MODEL_URL = "./my_model/";

    // Below this confidence, show "Not sure" instead of a class
    const MIN_CONFIDENCE = 0.6;

    // Look for each class, keyed by the label names trained in Teachable Machine
    const CLASS_STYLE = {
        "Coffee":       { color: "#6d4c41", emoji: "☕" },
        "Water Bottle": { color: "#1e88e5", emoji: "💧" },
        "Face":         { color: "#fb8c00", emoji: "🙂" },
    };
    const FALLBACK_COLORS = ["#e53935", "#43a047", "#8e24aa", "#00acc1"];
    const styleFor = (label, i) =>
        CLASS_STYLE[label] || { color: FALLBACK_COLORS[i % FALLBACK_COLORS.length], emoji: "" };

    let model, webcam, labelContainer, maxPredictions, labels = [], bars = [], pcts = [];

    function setStatus(msg, isError) {
        const el = document.getElementById("status");
        el.textContent = msg;
        el.className = isError ? "error" : "";
    }

    async function loadModel() {
        // 1) Files picked by hand
        const files = Array.from(document.getElementById("model-files").files);
        if (files.length) {
            const find = (test) => files.find(f => test(f.name.toLowerCase()));
            const modelFile = find(n => n.endsWith(".json") && !n.includes("metadata"));
            const weightsFile = find(n => n.endsWith(".bin"));
            const metaFile = find(n => n.includes("metadata"));
            if (!modelFile || !weightsFile || !metaFile) {
                throw new Error("Please select all 3 files: model.json, weights.bin and metadata.json.");
            }
            return tmImage.loadFromFiles(modelFile, weightsFile, metaFile);
        }
        // 2) Shareable link
        let url = document.getElementById("model-url").value.trim();
        // 3) Default: local ./my_model/ folder
        if (!url) url = MODEL_URL;
        if (!url.endsWith("/")) url += "/";
        return tmImage.load(url + "model.json", url + "metadata.json");
    }

    async function init() {
        const btn = document.getElementById("start-btn");
        btn.disabled = true;
        try {
            setStatus("Loading model…");
            model = await loadModel();
            maxPredictions = model.getTotalClasses();
            labels = model.getClassLabels();

            setStatus("Starting webcam… (allow camera access if asked)");
            webcam = new tmImage.Webcam(300, 300, true); // width, height, flip
            await webcam.setup();
            await webcam.play();

            const wc = document.getElementById("webcam-container");
            wc.innerHTML = "";
            wc.appendChild(webcam.canvas);

            labelContainer = document.getElementById("label-container");
            labelContainer.innerHTML = "";
            bars = []; pcts = [];
            for (let i = 0; i < maxPredictions; i++) {
                const s = styleFor(labels[i], i);
                const row = document.createElement("div");
                row.className = "row";
                row.innerHTML =
                    '<div class="name"><span style="color:' + s.color + ';font-weight:600"></span><span class="pct">0%</span></div>' +
                    '<div class="track"><div class="bar" style="background:' + s.color + '"></div></div>';
                row.querySelector(".name span").textContent = (s.emoji ? s.emoji + " " : "") + labels[i];
                labelContainer.appendChild(row);
                bars.push(row.querySelector(".bar"));
                pcts.push(row.querySelector(".pct"));
            }

            document.getElementById("model-picker").open = false;
            setStatus("Running. Detected classes: " + labels.join(", "));
            btn.textContent = "Running";
            window.requestAnimationFrame(loop);
        } catch (err) {
            console.error(err);
            let msg = err && err.message ? err.message : String(err);
            if (err && (err.name === "NotAllowedError" || err.name === "NotFoundError")) {
                msg = "Couldn't access the webcam: " + msg;
            } else if (location.protocol === "file:") {
                msg = "The browser blocked loading ./my_model/ because this page was opened as a file. " +
                      "Choose the 3 files from the my_model folder below, then press Start again.";
                document.getElementById("model-picker").open = true;
            }
            setStatus("Error: " + msg, true);
            btn.disabled = false;
        }
    }

    async function loop() {
        webcam.update();
        await predict();
        window.requestAnimationFrame(loop);
    }

    async function predict() {
        const prediction = await model.predict(webcam.canvas);
        let best = 0;
        for (let i = 0; i < maxPredictions; i++) {
            const p = prediction[i].probability;
            bars[i].style.width = (p * 100).toFixed(0) + "%";
            pcts[i].textContent = (p * 100).toFixed(0) + "%";
            if (p > prediction[best].probability) best = i;
        }
        const top = document.getElementById("top");
        top.style.display = "block";
        if (prediction[best].probability < MIN_CONFIDENCE) {
            top.style.background = "#9e9e9e";
            top.textContent = "🤔 Not sure";
            webcam.canvas.style.borderColor = "#ddd";
        } else {
            const s = styleFor(prediction[best].className, best);
            top.style.background = s.color;
            top.textContent = (s.emoji ? s.emoji + " " : "") + prediction[best].className;
            webcam.canvas.style.borderColor = s.color;
        }
    }
</script>
</body>
</html>
